{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Starter",
  "description": "starters/<id>.yml (delta v1.1 §6.4 e R21): repositório-modelo com versão fixada. O id, o repo e a versão precisam bater com componentes.yml (regra R-COMPONENTE).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "titulo", "descricao", "repo", "versao", "comando", "prompt_para_agente",
    "praticas_aplicadas", "receitas", "dono", "status", "referencias"
  ],
  "properties": {
    "id": {"$ref": "#/$defs/slug"},
    "titulo": {"type": "string", "minLength": 1},
    "descricao": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "pattern": "^https://"},
    "versao": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "comando": {"type": "string", "minLength": 1},
    "prompt_para_agente": {"type": "string", "minLength": 1},
    "praticas_aplicadas": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receitas": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "dono": {"$ref": "#/$defs/slug"},
    "status": {"enum": ["adotar", "experimentar", "avaliar", "evitar"]},
    "referencias": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "planta": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grupo", "quando", "arquivo", "caminhos"],
        "properties": {
          "grupo": {"type": "string", "minLength": 1},
          "quando": {"type": "string", "minLength": 1},
          "arquivo": {"type": "string", "minLength": 1},
          "caminhos": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "nota": {"type": "string", "minLength": 1},
          "mecanismos": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["forca", "texto"],
              "properties": {
                "forca": {"enum": ["bloqueia", "pede-aprovacao", "avisa", "orienta"]},
                "texto": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
  }
}
