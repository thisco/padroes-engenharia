{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prática",
  "description": "Frontmatter de praticas/<faixa>/<ID>.md (spec §6.1). Domínio, momento e formato do ID são conferidos pelo validador contra esquemas/espinha.yml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "titulo", "dominio", "subdominio", "momento", "forca", "mecanismo", "status",
    "aplica", "referencias", "relacionadas", "dono", "revisado_em", "revisar_ate", "resumo"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "titulo": {"type": "string", "minLength": 1},
    "dominio": {"type": "string", "minLength": 1},
    "subdominio": {"type": ["string", "null"], "minLength": 1},
    "momento": {"type": "string", "minLength": 1},
    "forca": {"enum": ["bloqueia", "pede-aprovacao", "avisa", "orienta"]},
    "mecanismo": {"$ref": "#/$defs/mecanismo"},
    "status": {"enum": ["adotar", "experimentar", "avaliar", "evitar"]},
    "aplica": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z]+:[A-Za-z0-9._/-]+$"}
    },
    "resumo": {"type": "string", "minLength": 1, "maxLength": 160},
    "ferramentas_aprovadas": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "starter": {"oneOf": [{"$ref": "#/$defs/slug"}, {"type": "null"}]},
    "receitas": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "exemplos": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exemplo"}},
    "referencias": {"$ref": "#/$defs/ids_referencia", "minItems": 1},
    "mapeia": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9.-]+:[A-Za-z0-9.-]+$"}
    },
    "relacionadas": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "casos": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "dono": {"$ref": "#/$defs/slug"},
    "revisado_em": {"$ref": "#/$defs/data"},
    "revisar_ate": {"$ref": "#/$defs/data"}
  },
  "$defs": {
    "mecanismo": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["gatilhos"],
          "properties": {
            "verificador": {"type": ["string", "null"], "minLength": 1},
            "gatilhos": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gatilho"}},
            "mensagem": {"type": ["string", "null"], "minLength": 1, "maxLength": 400}
          }
        }
      ]
    },
    "gatilho": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evento"],
      "properties": {
        "evento": {
          "enum": [
            "antes-de-ferramenta", "depois-de-ferramenta", "ao-enviar-prompt", "ao-parar",
            "pre-commit", "commit-msg", "ci"
          ]
        },
        "ferramenta": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["ler", "editar", "escrever", "shell", "web", "mcp"]}
        },
        "caminhos": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "comando": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "data": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "exemplo": {
      "type": "string",
      "pattern": "^exemplos/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+$",
      "not": {"pattern": "(^|/)\\.\\.?(/|$)"}
    },
    "ids_referencia": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    }
  }
}
