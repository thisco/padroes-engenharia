{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roteiro",
  "description": "roteiros/<slug>.md: o primeiro dia de um time num projeto, com prompt inicial e um passo por item de `passos`. Corpo conferido pela regra R-ROTEIRO.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "titulo", "objetivo", "porta", "publico", "harnesses", "passos", "dominio", "momento", "pre_requisitos", "tempo", "praticas",
    "resultado_esperado", "referencias", "dono", "revisado_em"
  ],
  "properties": {
    "titulo": {"type": "string", "minLength": 1},
    "objetivo": {"type": "string", "minLength": 1},
    "porta": {"enum": ["projeto-novo", "projeto-existente", "mudanca"]},
    "publico": {"type": "string", "minLength": 1},
    "harnesses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "passos": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/passo"}},
    "dominio": {"$ref": "#/$defs/slug"},
    "momento": {"$ref": "#/$defs/slug"},
    "pre_requisitos": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tempo": {"type": "integer", "minimum": 1},
    "praticas": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resultado_esperado": {"type": "string", "minLength": 1},
    "ferramentas_aprovadas": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "starter": {"$ref": "#/$defs/slug"},
    "exemplos": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exemplo"}},
    "referencias": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "dono": {"$ref": "#/$defs/slug"},
    "revisado_em": {"$ref": "#/$defs/data"}
  },
  "$defs": {
    "data": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "passo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titulo", "quem"],
      "properties": {
        "titulo": {"type": "string", "minLength": 1},
        "quem": {"enum": ["voce", "agente", "voce-decide"]}
      }
    },
    "exemplo": {
      "type": "string",
      "pattern": "^exemplos/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+$",
      "not": {"pattern": "(^|/)\\.\\.?(/|$)"}
    }
  }
}
